{
  "name": "hausverwaltung",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "clasp:login": "zsh -lc 'source ~/.nvm/nvm.sh && nvm use >/dev/null && clasp --auth .clasprc.json login'",
    "clasp:status": "zsh -lc 'source ~/.nvm/nvm.sh && nvm use >/dev/null && clasp --auth .clasprc.json status'",
    "clasp:pull": "zsh -lc 'source ~/.nvm/nvm.sh && nvm use >/dev/null && clasp --auth .clasprc.json pull'",
    "clasp:push": "zsh -lc 'source ~/.nvm/nvm.sh && nvm use >/dev/null && clasp --auth .clasprc.json push'",
    "test": "vitest run",
    "qa:consumption-matrix": "node tools/qa-consumption-matrix.mjs",
    "qa:consumption-snapshot": "node tools/fetch-verbrauch-snapshot.mjs"
  },
  "devDependencies": {
    "@google/clasp": "^3.3.0",
    "vitest": "^1.5.0"
  }
}
